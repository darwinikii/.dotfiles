//   / ____/___ ______/ /_/ ____/___ _/ /_
//  / /_  / __ `/ ___/ __/ /   / __ `/ __/
// / __/ / /_/ (__  ) /_/ /___/ /_/ / /_  
///_/    \__,_/____/\__/\____/\__,_/\__/  
//  https://github.com/m3tozz/FastCat


{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
    "color": {
        "1": "#7E53AF"
    }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "#7E53AF",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "datetime",
            "format": "{1}-{3}-{11}",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        {
            "type": "media",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        "break",
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "#7E53AF"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "keyColor": "#7E53AF",
            "format": "{1} {2}"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "#7E53AF"
        },
        {
            "type": "swap",
            "key": " ",
            "keyColor": "#7E53AF"
        },
        {
            "type": "display",
            "key": " ",
            "keyColor": "#7E53AF",
        },
        "break",
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "#7E53AF",
        }
        ]
}
