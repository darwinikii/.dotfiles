[
    {
        "name": "top",
        "layer": "top",
        "position": "top",
        "mod": "dock",
        "exclusive": true,
        "passthrough": false,
        "gtk-layer-shell": true,
        "height": 30,
        "modules-left": ["custom/menu", "gamemode", "hyprland/workspaces", "custom/mediaplayer", "hyprland/window"],
        "modules-center": ["clock"],
        "modules-right": ["custom/pacman", "custom/trash", "memory", "cpu", "pulseaudio", "custom/playeraudio", "pulseaudio#microphone", "custom/network", "tray", "custom/windows", "custom/exit"],
        "output": "DP-1",
        "margin-top": 10,

        "hyprland/window": {
            "format": "{}"
        },

        "custom/network": {
            "exec-on-event": true,
            "return-type": "json",
            "format": "{}",
            "restart-interval": 3600,
            "exec": "python ~/.config/waybar/bin/network.py",
            "on-click": "",
            "tooltip": false
        },

        "custom/mediaplayer": {
            "exec": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py",
            "format": "{} {icon}",
            "format-icons": {
              "spotify": "",
              "youtube": "",
              "default": "🎜"
            },
            "return-type": "json",
            "on-click": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --play-pause",
            "on-scroll-up": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --next",
            "on-scroll-down": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --prev"
        },

        "hyprland/workspaces": {
            "format": "{icon}",
            "disable-scroll": true,
            "persistent_workspaces": {
                "DP-1": [1, 3],
                "HDMI-A-1": [2, 4]
            },
            "format-icons": {
            "active": "󰮯",
            "default": "󰊠",
            "empty": "󰧵"
        }
        },

        "custom/menu": {
            "format": "",
            "tooltip": false,
            "on-click": "~/.config/wofi/start"
        },

        "gamemode": {
            "format": "{glyph}",
            "format-alt": "{glyph} {count}",
            "glyph": "󰊴",
            "hide-not-running": true,
            "use-icon": true,
            "icon-name": "input-gaming-symbolic",
            "icon-size": 17,
            "tooltip": true,
            "tooltip-format": "Games running: {count}"
        },

        "tray": {
            "icon-size": 18,
            "spacing": 10,

        },

        "clock": {
            "format": " {:%H:%M}",
            "tooltip-format": "<tt><small>{calendar}</small></tt>"
        },

        "custom/playeraudio": {
            "exec":   "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --playeraudio",
            "return-type": "json",
            "tooltip":  true,
            "tooltip-format": "{1}",
            "on-click": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --mute",
            "on-scroll-up": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --volume-up",
            "on-scroll-down": "/usr/bin/python3 ~/.config/waybar/bin/mediaplayer.py --volume-down"
        },

        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": " Muted",
            "on-click": "pamixer -t",
            "on-scroll-up": "pamixer -i 5",
            "on-scroll-down": "pamixer -d 5",
            "on-click-right": "pavucontrol",
            "scroll-step": 5,
            "format-icons": {
                "headphone": "",
                "hands-free": "",
                "headset": "",
                "phone": "",
                "portable": "",
                "car": "",
                "default": ["", "", ""]
            }
        },

        "pulseaudio#microphone": {
            "format": "{format_source}",
            "format-source": " {volume}%",
            "format-source-muted": " Muted",
            "on-click": "pamixer --default-source -t",
            "on-scroll-up": "pamixer --default-source -i 5",
            "on-scroll-down": "pamixer --default-source -d 5",
            "on-click-right": "pavucontrol",
            "scroll-step": 5
        },

        "memory": {
            "interval": 30,
            "format": "{}% ",
            "max-length": 10,
            "tooltip": true,
            "tooltip-format": "RAM : {used:0.1f}G/{total:0.1f}G\nSwap : {swapUsed:0.1f}G/{swapTotal:0.1f}G",
        },

        "cpu": {
            "interval": 10,
            "format": "{usage}% ",
            "max-length": 10
        },

        "custom/windows": {
          "format": "",
          "tooltip-format": "Reboot for Windows",
          "on-click": "systemctl reboot --boot-loader-entry=auto-windows"
        },

        "custom/exit": {
        "format": "⏻",
        "tooltip-format": "Shutdown",
        "on-click": "systemctl poweroff"
        }
    }
]

